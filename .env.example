# ============================================================
# Bridge-PA — Environment Variable Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- Veea Lobster Trap (PHI Audit Proxy) ---
VEEA_LOBSTER_TRAP_API_ENDPOINT=
VEEA_LOBSTER_TRAP_API_KEY=

# --- Enterprise Secret Vault ---
SECRET_VAULT_ENDPOINT=
SECRET_VAULT_AUTH_TOKEN=

# --- Payer Master Configuration Table ---
PAYER_CONFIG_TABLE_ENDPOINT=
PAYER_CONFIG_TABLE_API_KEY=

# --- UM Specialist Registry ---
UM_SPECIALIST_REGISTRY_ENDPOINT=
UM_SPECIALIST_REGISTRY_API_KEY=

# --- PostgreSQL Checkpointer ---
POSTGRESQL_CONNECTION_STRING=

# --- High Priority Queue ---
HIGH_PRIORITY_QUEUE_ENDPOINT=

# --- UM Manager Notification ---
UM_MANAGER_NOTIFICATION_ENDPOINT=

# --- Fax Intake Source ---
INTAKE_SOURCE_BASE_URL=
INTAKE_SOURCE_API_KEY=

# --- Integration Manifest ---
APPROVED_INTEGRATION_MANIFEST_VERSION=

# --- Baseline Safety Constants (DO NOT CHANGE — enforced in code) ---
BASELINE_COST_THRESHOLD_USD=
BASELINE_LOS_THRESHOLD_DAYS=

# --- Rate Limits ---
PORTAL_API_RATE_LIMIT_PER_MINUTE=
PAYER_CONFIG_RATE_LIMIT_PER_MINUTE=

# --- Server ---
API_HOST=
API_PORT=
FRONTEND_ORIGIN=

# --- Observability ---
LOG_LEVEL=
ENVIRONMENT=
