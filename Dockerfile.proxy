# Use official Python 3.12 slim image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies (httpx, pydantic, fastapi, uvicorn required from base requirements)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy mock proxy source code
COPY src/mock_proxy/ /app/src/mock_proxy/

# Expose proxy port
EXPOSE 8080

# Environment variables for proxy
ENV MOCK_PROXY_HOST=0.0.0.0
ENV MOCK_PROXY_PORT=8080

# Run mock proxy using the launcher script
CMD ["python", "-m", "src.mock_proxy.start_proxy"]
